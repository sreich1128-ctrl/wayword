    {
      "id": "table_for",
      "target": "Un tavolo per ___, per favore.",
      "pronunciation_easy": "oon TAH-voh-loh pehr, pehr fah-VOH-reh",
      "qa": "Blank takes the number of people (due, tre, quattro). For one person the natural phrasing is 'per una persona' rather than 'per uno', so the example uses that."
    },
    {
      "id": "menu_please",
      "target": "Il menù, per favore.",
      "pronunciation_easy": "eel meh-NOO, pehr fah-VOH-reh",
      "qa": "Spelled 'menù' or 'menu'; both are standard."
    },
    {
      "id": "allergic_to",
      "target": "Sono allergico a ___.",
      "pronunciation_easy": "SOH-noh al-LEHR-jee-koh ah",
      "qa": "SAFETY. Back-translation: 'I am allergic to ___'. Gender: masculine speaker form; a woman says 'Sono allergica a ___' (al-LEHR-jee-kah). The fixed 'a' merges with the article of the food: al glutine, alla frutta a guscio, ai frutti di mare, alle uova, al latte, alle arachidi; see the examples, don't paste the word after 'a'."
    },
    {
      "id": "vegetarian",
      "target": "Sono vegetariano.",
      "pronunciation_easy": "SOH-noh veh-jeh-tah-RYAH-noh",
      "qa": "Masculine speaker form (file convention, as in 'Sono nuovo qui'). A woman says 'Sono vegetariana.' (veh-jeh-tah-RYAH-nah)."
    },
    {
      "id": "without",
      "target": "Senza ___, per favore.",
      "pronunciation_easy": "SEN-tsah, pehr fah-VOH-reh",
      "qa": "SAFETY. Back-translation: 'Without ___, please.' 'Senza' takes the bare noun, no article (senza latte, senza glutine). For a serious allergy, combine with allergic_to so staff know it's not a preference."
    },
    {
      "id": "to_go",
      "target": "Da portare via, per favore.",
      "pronunciation_easy": "dah por-TAH-reh VEE-ah, pehr fah-VOH-reh",
      "qa": "Literally 'to carry away'. 'Da asporto' is the more formal/written term."
    },
    {
      "id": "for_here",
      "target": "Da mangiare qui, per favore.",
      "pronunciation_easy": "dah mahn-JAH-reh kwee, pehr fah-VOH-reh",
      "qa": "Literally 'to eat here'. Staff often say 'da consumare qui'; for a drink, 'Da bere qui'. In an Italian bar you'd more often just say 'Qui'. Reviewer: check naturalness."
    },
    {
      "id": "delicious",
      "target": "Era buonissimo.",
      "pronunciation_easy": "EH-rah bwoh-NEES-see-moh",
      "qa": "Agrees with the dish: 'buonissima' for a feminine dish (la pizza). 'Era tutto buonissimo.' (It was all delicious) works for a whole meal and avoids the choice."
    },
    {

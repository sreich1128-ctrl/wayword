    },
    {
      "id": "no_thank_you",
      "target": "No, gracias.",
      "pronunciation_easy": "noh, GRAH-syas"
    },
    {
      "id": "okay",
      "target": "Está bien.",
      "pronunciation_easy": "es-TAH byen",
      "qa": "Neutral choice. Regional alternatives: \"Vale\" (Spain), \"Dale\" (Argentina, Uruguay, Caribbean), \"Sale\" (Mexico, casual); \"Ok\" is understood everywhere."
    },
    {
      "id": "good_evening",
      "target": "Buenas noches.",
      "pronunciation_easy": "BWEH-nas NOH-ches",
      "qa": "Used once it's dark (also means good night). Late afternoon/early evening while still light is \"Buenas tardes\"."
    },
    {
      "id": "table_for",
      "target": "Una mesa para ___, por favor.",
      "pronunciation_easy": "OO-nah MEH-sah PAH-rah, por fah-VOR",
      "qa": "Blank takes the bare number (uno, dos...). \"Para uno\" is fine; \"para una persona\" is an equally common alternative."
    },
    {
      "id": "menu_please",
      "target": "La carta, por favor.",
      "pronunciation_easy": "lah KAR-tah, por fah-VOR",
      "qa": "\"La carta\" is understood everywhere. \"El menú\" is very common in Latin America, but in Spain \"el menú\" usually means the set lunch (menú del día)."
    },
    {
      "id": "allergic_to",
      "target": "Soy alérgico a ___.",
      "pronunciation_easy": "soy ah-LEHR-hee-koh ah",
      "qa": "Back-translation: \"I am allergic to ___.\" Masculine speaker (file convention); a woman says \"Soy alérgica a ___\" (ah-LEHR-hee-kah). a + el contracts to al (al gluten, al maní), so the article goes with the word, not the frame. Safety item: please verify. Word notes: peanuts = \"maní\" (most of Latin America), \"cacahuate\" (Mexico), \"cacahuete\" (Spain). Nuts = \"frutos secos\" (tree nuts generally); \"nueces\" strictly means walnuts but is used loosely in Mexico. Back-translations of examples: \"I am allergic to the nuts / the peanut / the gluten / the shellfish / the milk / the eggs\" (Spanish uses the article here). Dairy = \"los lácteos\"."
    },
    {
      "id": "vegetarian",
      "target": "Soy vegetariano.",
      "pronunciation_easy": "soy veh-heh-tah-RYAH-noh",
      "qa": "Masculine speaker; a woman says \"Soy vegetariana\"."
    },
    {
      "id": "without",
      "target": "Sin ___, por favor.",
      "pronunciation_easy": "seen, por fah-VOR",
      "qa": "Back-translation: \"Without ___, please.\" The noun after sin normally drops its article (sin leche, sin gluten), so examples omit it. Safety item (used for allergies/diet): please verify. Examples back-translate as \"Without meat / milk / gluten / ice / nuts, please\"."
    },
    {
      "id": "to_go",
      "target": "Para llevar, por favor.",
      "pronunciation_easy": "PAH-rah yeh-VAR, por fah-VOR"
    },
    {
      "id": "for_here",
      "target": "Para comer aquí, por favor.",
      "pronunciation_easy": "PAH-rah koh-MEHR ah-KEE, por fah-VOR",
      "qa": "Literally \"to eat here\". For a drink only, \"Para tomar aquí\" fits better."
    },
    {
      "id": "delicious",
      "target": "Estaba delicioso.",
      "pronunciation_easy": "es-TAH-bah deh-lee-SYOH-soh",
      "qa": "\"Estuvo delicioso\" is equally common in Latin America; \"Estaba buenísimo\" in Spain."
    },
    {
      "id": "another_one",
      "target": "Otro, por favor.",
      "pronunciation_easy": "OH-troh, por fah-VOR",
      "qa": "Agrees with the thing ordered: \"Otra, por favor\" for a feminine noun (otra cerveza, otra copa)."
    },
    {
      "id": "ticket_to",
      "target": "Un boleto a ___, por favor.",
      "pronunciation_easy": "oon boh-LEH-toh ah, por fah-VOR",
      "qa": "\"Boleto\" is Latin American; Spain says \"billete\", and Argentina/Chile often \"pasaje\" for long-distance. a + el contracts to al (al aeropuerto)."
    },
    {
      "id": "does_this_go_to",
      "target": "¿Este va a ___?",
      "pronunciation_easy": "ES-teh vah ah",
      "qa": "\"Este\" = this one (bus/train, masculine). a + el contracts to al."
    },
    {
      "id": "take_me_to",
      "target": "Llévame a ___, por favor.",
      "pronunciation_easy": "YEH-vah-meh ah, por fah-VOR",
      "qa": "Uses tú like the rest of the file. With taxi drivers in much of Latin America usted is more usual: \"¿Me lleva a ___, por favor?\". a + el contracts to al."
    },
    {
      "id": "stop_here",
      "target": "Para aquí, por favor.",
      "pronunciation_easy": "PAH-rah ah-KEE, por fah-VOR",
      "qa": "tú form; usted form is \"Pare aquí, por favor\" (common with taxi drivers)."
    },
    {
      "id": "next_departure",
      "target": "¿Cuándo sale el próximo?",
      "pronunciation_easy": "KWAN-doh SAH-leh el PROK-see-moh",
      "qa": "\"El próximo\" assumes a masculine vehicle (tren, autobús); \"la próxima\" if referring to a feminine one."
    },
    {
      "id": "which_platform",
      "target": "¿De qué andén sale?",
      "pronunciation_easy": "deh keh an-DEN SAH-leh",
      "qa": "Literally \"From which platform does it leave?\". Spanish train stations often say \"vía\" (track) instead of andén; bus stations may use \"plataforma\"."
